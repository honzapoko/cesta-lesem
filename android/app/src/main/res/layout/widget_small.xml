<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/widget_bg" android:orientation="horizontal" android:gravity="center_vertical" android:padding="12dp">
    <ImageView android:id="@+id/w_sloth" android:layout_width="40dp" android:layout_height="40dp" android:src="@drawable/widget_sloth" android:contentDescription="Slothkin"/>
    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginStart="10dp">
        <TextView android:id="@+id/w_progress" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="–" android:textColor="#1E2A4A" android:textSize="20sp" android:textStyle="bold"/>
        <TextView android:id="@+id/w_streak" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0 dní v řadě" android:textColor="#7A6A55" android:textSize="11sp"/>
    </LinearLayout>
</LinearLayout>
