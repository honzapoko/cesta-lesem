<?xml version="1.0" encoding="utf-8"?>
<!-- Střední widget 4x2: vlevo parťák + splněno + dny v řadě, vpravo posouvatelné karty úkolů (stejné jako widget Úkoly). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/widget_bg" android:orientation="horizontal" android:padding="10dp">
    <LinearLayout android:layout_width="84dp" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center_horizontal">
        <ImageView android:id="@+id/w_sloth" android:layout_width="64dp" android:layout_height="64dp" android:src="@drawable/widget_sloth" android:scaleType="fitCenter" android:contentDescription="Poquito"/>
        <TextView android:id="@+id/w_progress" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="–" android:textColor="#1E2A4A" android:textSize="20sp" android:textStyle="bold"/>
        <TextView android:id="@+id/w_streak" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0 dní v řadě" android:textColor="#7A6A55" android:textSize="11sp" android:gravity="center" android:maxLines="2"/>
        <TextView android:id="@+id/w_lead" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
    </LinearLayout>
    <FrameLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:layout_marginStart="6dp">
        <ListView android:id="@+id/w_list" android:layout_width="match_parent" android:layout_height="match_parent" android:divider="@null" android:dividerHeight="0dp" android:scrollbars="none"/>
        <TextView android:id="@+id/w_empty" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:text="＋" android:textColor="#9A8A75" android:textSize="14sp"/>
    </FrameLayout>
</LinearLayout>
