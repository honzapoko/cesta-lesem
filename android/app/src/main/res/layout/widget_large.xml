<?xml version="1.0" encoding="utf-8"?>
<!-- Velký widget 4x4: parťák, splněno, dny v řadě, mince, nálada; posouvatelné karty úkolů; věta dne. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/widget_bg" android:orientation="vertical" android:padding="12dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <ImageView android:id="@+id/w_sloth" android:layout_width="72dp" android:layout_height="72dp" android:src="@drawable/widget_sloth" android:scaleType="fitCenter" android:contentDescription="Poquito"/>
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginStart="8dp">
            <TextView android:id="@+id/w_progress" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="–" android:textColor="#1E2A4A" android:textSize="24sp" android:textStyle="bold"/>
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal">
                <TextView android:id="@+id/w_streak" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0 dní v řadě" android:textColor="#7A6A55" android:textSize="12sp"/>
                <TextView android:id="@+id/w_coins" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🪙 0" android:textColor="#7A6A55" android:textSize="12sp" android:layout_marginStart="10dp"/>
            </LinearLayout>
            <TextView android:id="@+id/w_lead" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Pomalu, ale jistě." android:textColor="#7A6A55" android:textSize="12sp" android:maxLines="2" android:ellipsize="end"/>
        </LinearLayout>
    </LinearLayout>
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="6dp">
        <ListView android:id="@+id/w_list" android:layout_width="match_parent" android:layout_height="match_parent" android:divider="@null" android:dividerHeight="0dp" android:scrollbars="none"/>
        <TextView android:id="@+id/w_empty" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:text="＋" android:textColor="#9A8A75" android:textSize="14sp"/>
    </FrameLayout>
    <TextView android:id="@+id/w_quote" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:textColor="#5E7A4A" android:textSize="12sp" android:textStyle="italic" android:layout_marginTop="6dp" android:maxLines="2" android:ellipsize="end"/>
</LinearLayout>
